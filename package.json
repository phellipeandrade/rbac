{
  "name": "rbac-v4-workspace",
  "version": "4.0.1",
  "description": "Blazing Fast, Zero dependency, Hierarchical Role-Based Access Control for Node.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:packages && node scripts/build-entrypoints.mjs",
    "build:packages": "npm run build:core && npm run build:integrations",
    "build:core": "tsc -p packages/core",
    "build:integrations": "tsc -p packages/adapters && tsc -p packages/express && tsc -p packages/fastify && tsc -p packages/nestjs && tsc -p packages/schemas",
    "dev": "tsc -b -w",
    "examples": "node -r ts-node/register ./examples/index.ts",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:npm": "npm run test:package",
    "test:package": "npm run build && node test/package-exports.test.mjs && tsc -p test/package-types && node scripts/test-packed.mjs",
    "lint": "eslint packages --max-warnings 0",
    "typecheck": "npm run build && tsc -p test/package-types",
    "bench": "node ./benchmarks/perf.js",
    "bench:engine": "node ./benchmarks/engine.js",
    "bench:micro": "node ./benchmarks/micro.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phellipeandrade/rbac.git"
  },
  "keywords": [
    "rbac",
    "authorization",
    "hierarchical",
    "privacy",
    "role",
    "security",
    "permission",
    "acl"
  ],
  "author": "Phellipe Andrade",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phellipeandrade/rbac/issues"
  },
  "homepage": "https://github.com/phellipeandrade/rbac",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "accesscontrol": "^2.2.1",
    "asciichart": "^1.5.25",
    "benny": "^3.7.1",
    "easy-rbac": "^4.0.0",
    "eslint": "^9.35.0",
    "fast-rbac": "^2.0.1",
    "jest": "^30.1.3",
    "rbac": "^5.0.3",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "fastify": "^5.6.0"
  },
  "overrides": {
    "undici-types": "^7.10.0",
    "brace-expansion@1": "^1.1.21",
    "minimatch@9": "^11.0.8",
    "minimatch@10": "^11.0.8",
    "glob": "^14.0.6",
    "deepmerge@4": "4.1.1"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
