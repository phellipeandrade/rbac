{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": { "@rbac-engine": ["../src/rbac.ts"] },
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "docusaurus.config.ts", "sidebars.ts"]
}
