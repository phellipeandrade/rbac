{
  "name": "@rbac/website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run generate:api && docusaurus start",
    "generate:api": "node scripts/generate-api.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run check:examples && npm run generate:api && npm run check:translations && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@uiw/react-codemirror": "^4.25.4",
    "@xyflow/react": "^12.9.3",
    "acorn": "^8.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@shikijs/rehype": "^4.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.15.30",
    "minimatch": "^11.0.8",
    "autoprefixer": "^10.4.21",
    "shiki": "^4.6.0",
    "tailwindcss": "^3.4.17",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "tinypool@1": "^2.2.0",
    "serialize-javascript@6": "^7.1.4",
    "typedoc": {
      "minimatch": "^11.0.8"
    },
    "deepmerge@4": "4.1.1",
    "uuid@8": "^11.1.1",
    "katex": "^0.18.2"
  }
}
